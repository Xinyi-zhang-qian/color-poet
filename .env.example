# ============================================================
# 色彩诗卡 ColorPoet 环境配置
# 复制本文件为 .env 并填入你的密钥（.env 已被 git 忽略，不会提交）
# ============================================================

# 阿里云百炼 (DashScope) API Key —— 用于通义万相图像生成（必填）
# 获取地址：https://bailian.console.aliyun.com/  →  API-KEY 管理
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 通义万相文生图模型（可选）：wanx2.1-t2i-turbo 极速 / wanx2.1-t2i-plus 专业
WANX_MODEL=wanx2.1-t2i-turbo

# 通义千问 LLM（可选）：用于 agent 意境理解，不填则使用内置规则引擎
# 与 DASHSCOPE_API_KEY 是同一个百炼 Key
QWEN_MODEL=qwen-plus

# 后端服务端口
PORT=8787
